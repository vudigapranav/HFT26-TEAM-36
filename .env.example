# K1 works without an env file. Optional defaults are documented in the backend README.
# Later implementation tasks will validate these server-only values when required.
DATABASE_URL=
FEATHERLESS_API_KEY=
# K2 auth is opt-in. Export these variables; .env is not loaded automatically.
APP_MODE=
AUTH_ORIGIN=
# HTTPS AUTH_ORIGIN enables Secure and __Host- cookies; HTTP is loopback-only.

# Docker demo runner (RUNNER=docker); image defaults to torquecode-runner-python:dev
RUNNER=
RUNNER_IMAGE=
# Optional cloud runner instead of Docker (RUNNER=e2b): server-only key; template from `pnpm --filter @torquecode/backend e2b:template`
E2B_API_KEY=
E2B_TEMPLATE=
FEATHERLESS_MODEL_GENERATION=
FEATHERLESS_MODEL_ASSISTANT=

# Enable only behind the trusted Vercel reverse proxy; default false.
TRUST_PROXY=
