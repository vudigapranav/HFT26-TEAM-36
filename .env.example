# K1 works without an env file. Optional defaults are documented in the backend README.
# Later implementation tasks will validate these server-only values when required.
DATABASE_URL=
FEATHERLESS_API_KEY=
# K2 auth is opt-in. Export these variables; .env is not loaded automatically.
APP_MODE=
AUTH_ORIGIN=
# HTTPS AUTH_ORIGIN enables Secure and __Host- cookies; HTTP is loopback-only.
