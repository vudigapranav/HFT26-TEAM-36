# Copied to deploy/.env by deploy/start.sh (git-ignored). Secret values stay blank here.
# start.sh generates POSTGRES_PASSWORD when it is blank.
POSTGRES_PASSWORD=
POSTGRES_PORT=54329
BACKEND_PORT=3001
# The browser origin of the frontend (same-origin /api proxy). Loopback HTTP only for the local demo.
AUTH_ORIGIN=http://127.0.0.1:4177
RUNNER_IMAGE=torquecode-runner-python:dev
# Blank = taken from the repo-root .env if it is set there. Never commit a real key.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL_GENERATION=
FEATHERLESS_MODEL_ASSISTANT=
