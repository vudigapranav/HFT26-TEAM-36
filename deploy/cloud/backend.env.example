# /etc/torquecode/backend.env on the VM (root:torquecode, chmod 640). Never commit real values.
APP_MODE=auth
HOST=127.0.0.1
PORT=3001
# The public Vercel URL, exactly (scheme + host, no path). HTTPS => Secure __Host- cookies.
AUTH_ORIGIN=
# Filled by setup-vm.sh from deploy/.env (PostgreSQL on 127.0.0.1 only).
DATABASE_URL=
RUNNER=docker
RUNNER_IMAGE=torquecode-runner-python:dev
RUNNER_MAX_CONCURRENT=2
RUNNER_MAX_QUEUE=8
# Karthik's K11: trust exactly one proxy hop (Caddy on loopback). Not on main yet.
TRUST_PROXY=
# Python for K5's static analysis tools.
TORQUECODE_PYTHON=/usr/bin/python3
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL_GENERATION=
FEATHERLESS_MODEL_ASSISTANT=
