    },
    "security": {
      "owasp": 3, "penetration-testing": 3, "pentesting": 3, "burp-suite": 3, "burpsuite": 3,
      "wireshark": 3, "nmap": 3, "metasploit": 3, "cryptography": 3, "ctf": 3,
      "sql-injection": 3, "reverse-engineering": 3,
      "security": 2, "xss": 2,
