{
  "name": "@torquecode/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/copy-build-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "node --import tsx api/server.ts",
    "start": "node dist/api/server.js",
    "test": "vitest run --config vitest.config.ts",
    "smoke:seams": "node --import tsx api/smoke-seams.ts",
    "test:seed1": "node --import tsx api/check-seed.ts",
    "openapi": "node --import tsx api/openapi.ts",
    "db:migrate": "node --import tsx api/db/command.ts",
    "gen:smoke": "node --env-file-if-exists=../../.env --import tsx generation/smoke.ts",
    "llm:eval": "node --env-file-if-exists=../../.env --import tsx llm/live-eval.ts",
    "llm:smoke": "node --env-file-if-exists=../../.env --import tsx llm/smoke.ts",
    "e2b:template": "node --env-file-if-exists=../../.env --import tsx runner/e2bTemplate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/swagger": "^9.0.0",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@torquecode/contracts": "workspace:*",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.45.1",
    "e2b": "^2.62.0",
    "fastify": "5.12.7",
    "pg": "^8.23.1",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
