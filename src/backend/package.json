{
  "name": "@torquecode/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "node --import tsx api/server.ts",
    "start": "node dist/api/server.js",
    "test": "vitest run --config vitest.config.ts",
    "smoke:seams": "node --import tsx api/smoke-seams.ts",
    "test:seed1": "node --import tsx api/check-seed.ts",
    "openapi": "node --import tsx api/openapi.ts"
  },
  "dependencies": {
    "@torquecode/contracts": "workspace:*",
    "@fastify/swagger": "^9.0.0",
    "@fastify/type-provider-typebox": "^6.3.0",
    "ajv-formats": "^3.0.1",
    "fastify": "5.12.7",
    "typebox": "1.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
