{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": [
      "node"
    ]
  },
  "include": [
    "api/**/*.ts",
    "contracts/*.ts",
    "runner/local/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "runner/**/*.ts",
    "intake/**/*.ts",
    "scoring/**/*.ts",
    "llm/**/*.ts",
    "generation/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "contracts/dist"
  ]
}
