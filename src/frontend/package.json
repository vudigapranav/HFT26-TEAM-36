{
  "name": "torquecode-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4177 --strictPort",
    "start": "npm run dev",
    "build": "pnpm --filter @torquecode/contracts build && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4177 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@torquecode/contracts": "workspace:*",
    "@vercel/functions": "^3.10.5",
    "monaco-editor": "^0.55.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^30.1.3",
    "typebox": "1.4.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.0.5"
  }
}
